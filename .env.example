# ============================================
# FitCheck Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — your secrets stay on your machine.

# SUPABASE — https://supabase.com > Your Project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# CLOUDINARY — https://cloudinary.com > Dashboard
# Cloud name is shown at the top of your Cloudinary dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Future phases (not needed yet):
# OPENWEATHER_API_KEY=
# ANTHROPIC_API_KEY=
